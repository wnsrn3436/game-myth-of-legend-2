//색상구별

switch(argument0)
{
    case 0: draw_set_color(c_blue); break;
    case 1: draw_set_color(c_red); break;
    case 2: draw_set_color(c_dkgray); break;
    case 3: draw_set_color(c_fuchsia); break;
    case 4: draw_set_color(c_teal); break;
    case 5: draw_set_color(c_aqua); break;
    case 6: draw_set_color(c_lime); break;
    case 7: draw_set_color(c_orange); break;
    case 8: draw_set_color(c_white); break;
    case 9: draw_set_color(c_black); break;
}

