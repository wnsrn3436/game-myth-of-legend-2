if player_id=1{draw_set_color(c_blue)}      //파랑
if player_id=2{draw_set_color(c_red)}      //빨강
if player_id=3{draw_set_color(c_dkgray)}    //짙은 회색
if player_id=4{draw_set_color(c_fuchsia)}   //주황
if player_id=5{draw_set_color(c_teal)}    //물오리
if player_id=6{draw_set_color(c_aqua)}    //아쿠아
if player_id=7{draw_set_color(c_lime)}     //라임
if player_id=8{draw_set_color(c_orange)}      //오렌지