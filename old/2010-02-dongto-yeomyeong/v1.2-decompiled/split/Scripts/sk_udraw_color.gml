//색상구별

if argument0=0{draw_set_color(c_blue)}      //파랑
if argument0=1{draw_set_color(c_red)}      //빨강
if argument0=2{draw_set_color(c_dkgray)}    //짙은 회색
if argument0=3{draw_set_color(c_fuchsia)}   //주황
if argument0=4{draw_set_color(c_teal)}    //물오리
if argument0=5{draw_set_color(c_aqua)}    //아쿠아
if argument0=6{draw_set_color(c_lime)}     //라임
if argument0=7{draw_set_color(c_orange)}      //오렌지

